# Normalize text files to LF in the repo; let Git pick the working-copy default.
* text=auto

# Files executed inside Linux containers must always be LF, even on Windows checkouts.
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
