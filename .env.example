# =============================================================================
# Assignment Roaster - environment template
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# App
# development | test | production. In production the backend refuses to start with the
# placeholder SECRET_KEY below or a non-https FRONTEND_URL.
# NOTE: docker-compose.yml forces ENVIRONMENT=production; docker-compose.dev.yml forces development.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Reverse proxy: IPs/CIDRs uvicorn trusts for X-Forwarded-For/-Proto (rate limiting keys on the
# client IP). Set to your proxy / Docker network CIDR, never "*" if :8000 is reachable directly.
FORWARDED_ALLOW_IPS=127.0.0.1

# Postgres (used by docker-compose db service)
POSTGRES_USER=roaster
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assignment_roaster

# Database (local, non-docker). docker-compose overrides this to point at the `db` service.
DATABASE_URL=postgresql://roaster:change-me@localhost:5432/assignment_roaster

# Auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (>= 32 chars)
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# GitHub OAuth
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# GitHub API (server token, read-only public access)
GITHUB_API_TOKEN=ghp_your-token-here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5

# Roaster limits
ROAST_DAILY_LIMIT=5
MAX_REPO_SIZE_MB=50
MAX_SAMPLED_FILES=30
# Max roast pipelines (GitHub analysis + Claude call) running at once per backend process.
MAX_CONCURRENT_ROASTS=3

# URLs
# docker-compose.yml (nginx frontend): http://localhost:3000
# docker-compose.dev.yml / local `npm run dev`: http://localhost:5173 (dev compose sets this itself)
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000
